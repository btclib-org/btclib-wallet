# what integration-hwi.yml installs, locked and hashed for its runner in
# requirements-hwi.txt:
#   uv pip compile --python-version 3.12 \
#     --python-platform x86_64-unknown-linux-gnu --generate-hashes \
#     --no-header --override overrides-hwi.txt \
#     --output-file requirements-hwi.txt requirements-hwi.in
# overrides-hwi.txt replaces hwi's own `cbor2<5.8` and `protobuf<5.0.0`, whose
# newest releases, 5.7.1 and 4.25.9, carry published advisories; the workflow
# installs it with --no-deps for that reason
hwi==3.2.0
